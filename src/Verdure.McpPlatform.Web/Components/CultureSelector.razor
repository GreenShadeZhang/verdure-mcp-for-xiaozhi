@using System.Globalization
@using Microsoft.JSInterop
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Verdure.McpPlatform.Web.Resources
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc

<MudMenu AnchorOrigin="Origin.BottomCenter" 
         TransformOrigin="Origin.TopCenter"
         Dense="true">
    <ActivatorContent>
        <!-- MudBlazor 9: ActivatorContent is RenderFragment<MenuContext>; use context.ToggleAsync(e) -->
        <!-- 窄屏：仅图标按钮 -->
        <MudIconButton Icon="@Icons.Material.Filled.Translate"
                       Size="Size.Medium"
                       Class="d-inline-flex d-sm-none"
                       Style="@($"color: {TextColor};")"
                       @onclick="@(e => context.ToggleAsync(e))">
        </MudIconButton>
        <!-- 宽屏：带文字的按钮 -->
        <MudButton Variant="Variant.Text" 
                   StartIcon="@Icons.Material.Filled.Translate"
                   Size="Size.Small"
                   Class="d-none d-sm-inline-flex"
                   Style="@($"color: {TextColor};")"
                   @onclick="@(e => context.ToggleAsync(e))">
            @GetCultureDisplayName(_currentCulture)
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @foreach (var culture in _supportedCultures)
        {
            <MudMenuItem OnClick="@(() => OnCultureChanged(culture.Name))"
                        Class="@(culture.Name == _currentCulture ? "mud-theme-primary" : "")">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@GetCultureIcon(culture.Name)" Size="Size.Small" />
                    <MudText>@culture.DisplayName</MudText>
                    @if (culture.Name == _currentCulture)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" 
                                 Size="Size.Small" 
                                 Color="Color.Primary" 
                                 Class="ml-auto" />
                    }
                </div>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    /// <summary>
    /// 控制文字颜色，首页使用中性文本色，仪表盘使用白色
    /// </summary>
    [Parameter]
    public string TextColor { get; set; } = "var(--m3-on-surface-variant)";
    
    private string _currentCulture = string.Empty;

    protected override void OnInitialized()
    {
        // Read culture AFTER Blazor has applied applicationCulture at startup
        _currentCulture = CultureInfo.CurrentUICulture.Name;
    }

    private readonly CultureInfo[] _supportedCultures = new[]
    {
        new CultureInfo("zh-CN"),
        new CultureInfo("en")
    };

    private string GetCultureDisplayName(string cultureName)
    {
        return cultureName switch
        {
            "zh-CN" => "中文",
            "en" => "English",
            _ => cultureName
        };
    }

    private string GetCultureIcon(string cultureName)
    {
        return cultureName switch
        {
            "zh-CN" => Icons.Material.Filled.Translate,  // 中文图标
            "en" => Icons.Material.Filled.Language,       // 英文图标
            _ => Icons.Material.Filled.Language
        };
    }

    private async Task OnCultureChanged(string cultureName)
    {
        if (cultureName == _currentCulture)
        {
            return;
        }

        try
        {
            // Save culture to browser localStorage
            await JSRuntime.InvokeVoidAsync("blazorCulture.set", cultureName);
            
            // Use window.location.reload() instead of NavigateTo(uri, forceLoad: true).
            // In .NET 9/10 Blazor WASM, NavigateTo with forceLoad is deprecated and
            // unreliable for same-URL navigation — the browser may ignore the reload
            // because the destination matches the current URL.
            await JSRuntime.InvokeVoidAsync("eval", "window.location.reload()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing culture: {ex.Message}");
            // Fallback: navigate with a cache-busting timestamp to guarantee reload
            var sep = Navigation.Uri.Contains('?') ? "&" : "?";
            Navigation.NavigateTo($"{Navigation.Uri}{sep}_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
                new NavigationOptions { ForceLoad = true });
        }
    }
}
